# ====================================================================
# KAVISH 2.0 — LOCAL & STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# ====================================================================

# 1. Supabase PostgreSQL Database & Storage Configuration
# Replace with your Supabase Project URL and Public Anon Key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt-public-key

# Optional: Supabase Service Role Key (Used strictly for server-side administrative operations)
# NEVER EXPOSE THIS KEY ON THE CLIENT / FRONTEND
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Local / Staging PostgreSQL Database URL (For Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kavish_local?schema=public"

# 3. Razorpay Payment Gateway Credentials (Test / Live Mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_key
NEXT_PUBLIC_RAZORPAY_PAY_LINK=https://razorpay.me/@kavishhandlooms

# 4. Storefront Base URL (Local Development)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 5. Legacy Fallback Aliases (Maintained for backward compatibility)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-jwt-public-key
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
VITE_RAZORPAY_KEY_SECRET=your_razorpay_secret_key
